# NC Roofing Service environment variables
# Copy to .env.local for local development. Set these in Vercel for production.

# --- Lead capture ---------------------------------------------------------
# Resend (transactional email — used by /api/lead to notify the office)
# Sign up at https://resend.com; verify a sending domain (ncroofingservice.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=leads@ncroofingservice.com
LEAD_NOTIFICATION_EMAIL=info@ncroofingservice.com

# Google Apps Script webhook that appends each lead to a Google Sheet for
# backup + reporting. See LEAD_CAPTURE_SETUP.md for the script + deploy steps.
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Storm check ---------------------------------------------------------
# Google Geocoding API key for /api/storm-check (converts addresses -> lat/lon).
# https://developers.google.com/maps/documentation/geocoding/get-api-key
GOOGLE_GEOCODING_API_KEY=

# --- Site configuration --------------------------------------------------
# Optional override of the site URL used by metadata + sitemap. Defaults to
# https://ncroofingservice.com (see lib/site.ts).
# NEXT_PUBLIC_SITE_URL=https://ncroofingservice.com
